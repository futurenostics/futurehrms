{
  "name": "futurenostics-hrms",
  "version": "0.0.0",
  "private": true,
  "description": "Futurenostics HRMS — modular monolith covering commissions, payroll, HR increments and reminders.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\"",
    "dev:services": "docker compose up -d",
    "dev:services:down": "docker compose down",
    "dev:services:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "pnpm --filter @futurenostics/api exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @futurenostics/api exec prisma migrate deploy",
    "db:seed": "pnpm --filter @futurenostics/api exec tsx prisma/seed.ts",
    "db:studio": "pnpm --filter @futurenostics/api exec prisma studio",
    "db:reset": "pnpm --filter @futurenostics/api exec prisma migrate reset",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/node": "^22.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
