// Futurenostics HRMS — HR Core schema (Phase 0).
//
// This is the minimal schema every domain module composes on top of:
// identity (User, Role, Permission), org structure (Department,
// Designation, EmployeeStatus, Employee), and history (SalaryHistory,
// TimelineEntry, AuditLog). Module-specific tables (projects,
// commission rules, payroll runs, hr rules, ...) land in their own
// phase via Prisma's multi-file schema or additive migrations.
//
// Conventions enforced here:
//   - cuid() ids
//   - createdAt / updatedAt on every model
//   - deletedAt for soft delete on anything with HR/financial weight
//   - Decimal(14, 2) for money
//   - Indexes on the foreign keys used by list pages

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity & access ----------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])

  roles                   UserRole[]
  refreshTokens           RefreshToken[]
  notifications           Notification[]            @relation("UserNotifications")
  notificationPreferences NotificationPreference[]
  submittedApprovals      Approval[]                @relation("ApprovalSubmitter")
  approvalDecisions       ApprovalDecision[]

  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  ipAddress String?
  userAgent String?

  @@index([userId, expiresAt])
  @@index([tokenHash])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isSystem    Boolean  @default(false)

  permissions RolePermission[]
  users       UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  module      String
  action      String
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())

  @@index([module])
}

model UserRole {
  userId          String
  roleId          String
  departmentScope String?
  assignedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ---------- Org structure ----------

model Department {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  isActive Boolean @default(true)

  employees     Employee[]
  designations  Designation[]
  projects      Project[]
  reminderRules ReminderRule[] @relation("ReminderRulesByDepartment")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Designation {
  id           String     @id @default(cuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  isActive     Boolean    @default(true)

  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, departmentId])
  @@index([departmentId])
}

model EmployeeStatus {
  id         String  @id @default(cuid())
  name       String  @unique
  slug       String  @unique
  isTerminal Boolean @default(false)

  employees Employee[]
}

// ---------- Employee + lifecycle ----------

model Employee {
  id          String    @id @default(cuid())
  eid         String    @unique
  // fullName is kept as the canonical name field (joined first + last
  // on save); firstName / lastName are the inputs the new sheet
  // surfaces. Nullable so the migration can backfill existing rows.
  fullName    String
  firstName   String?
  lastName    String?
  pronouns    String?
  // `email` is the work email (locked after onboarding); personalEmail
  // is the optional secondary used as a login-fallback target.
  email         String    @unique
  personalEmail String?
  // `phone` is the work phone; personalPhone is optional secondary.
  phone         String?
  personalPhone String?
  address       String?
  dateOfBirth DateTime?
  gender      String?
  cnic        String?   @unique
  joinDate    DateTime

  departmentId  String
  department    Department     @relation(fields: [departmentId], references: [id])
  designationId String
  designation   Designation    @relation(fields: [designationId], references: [id])
  statusId      String
  status        EmployeeStatus @relation(fields: [statusId], references: [id])

  contractType     String
  // 'on_roll' | 'off_roll' | 'intern_stipend' | 'consultant_invoice'
  // — independent of contractType; tracks the legal / payroll record.
  employmentRecord String?

  managerId String?
  manager   Employee?  @relation("EmployeeManager", fields: [managerId], references: [id])
  reports   Employee[] @relation("EmployeeManager")

  user User?

  // Optional system role slug (mirrors Role.slug). Drives in-app
  // visibility; defaults to 'employee' at create time.
  systemRoleSlug String?

  salaryPkr                 Decimal?  @db.Decimal(14, 2)
  salaryEffectiveDate       DateTime?
  salaryProcessedExternally Boolean   @default(false)
  hasPayoneer               Boolean   @default(false)
  payoneerAccountId         String?
  payoneerEmail             String?
  eligibleForCommissions    Boolean   @default(false)
  // Free-form so HR can pick from a fixed list ('standard',
  // 'per_project_category', custom string) without a junction table.
  commissionRate            String?

  // PKR payroll bank account.
  bankName   String?
  bankBranch String?
  iban       String?

  internshipEndDate     DateTime?
  probationEndDate      DateTime?
  biannualReviewEnabled Boolean   @default(false)
  annualReviewEnabled   Boolean   @default(true)
  lastIncrementDate     DateTime?

  // Reminder delivery preferences. `timezone` is an IANA zone
  // (e.g. 'Asia/Karachi'); null falls back to the org default. Quiet
  // hours are wall-clock "HH:MM" strings in the employee's timezone —
  // reminders due during the window are deferred to `quietHoursEnd`.
  // Both null = no quiet hours.
  timezone         String?
  quietHoursStart  String?
  quietHoursEnd    String?

  emergencyContact Json?

  // Offboarding / termination state. noticePeriodStart marks 'Move
  // to Notice'; terminatedAt + lastWorkingDay + terminationReason +
  // terminationNotes capture the Terminate confirmation modal output.
  noticePeriodStart DateTime?
  terminatedAt      DateTime?
  lastWorkingDay    DateTime?
  terminationReason String?
  terminationNotes  String?

  documents             EmployeeDocument[]
  salaryHistory         SalaryHistory[]
  timeline              TimelineEntry[]
  projectAssignments    ProjectAssignment[]
  commissionLineItems   CommissionLineItem[]
  commissionDisputes    CommissionDispute[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([departmentId, statusId])
  @@index([managerId])
  @@index([deletedAt])
}

model EmployeeDocument {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind       String
  fileUrl    String
  uploadedAt DateTime @default(now())

  @@index([employeeId, kind])
}

model SalaryHistory {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  oldSalaryPkr  Decimal? @db.Decimal(14, 2)
  newSalaryPkr  Decimal  @db.Decimal(14, 2)
  effectiveDate DateTime
  remarks       String?
  changedBy     String
  createdAt     DateTime @default(now())

  @@index([employeeId, effectiveDate])
}

model TimelineEntry {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  eventType   String
  module      String
  title       String
  details     Json?
  occurredAt  DateTime
  createdById String?
  createdAt   DateTime @default(now())

  @@index([employeeId, occurredAt])
  @@index([eventType])
}

// ---------- Phase 2: Projects + Commissions ----------
//
// Projects, ProjectCategory (taxonomy), ProjectAssignment, and
// CommissionRule. The Commission Run + LineItem models land in
// Session 2 with the calculation engine.
//
// Locked decisions live in docs/DECISIONS.md § "Phase 2 — Business
// rules". The short version, because future-me will read this code
// without the doc open:
//
//   - CommissionRule is keyed by (department, categoryId, version).
//     `department` may be the literal '*' to mean an org-wide
//     fallback when no dept-specific rule exists.
//   - Roles inside a rule are stored as a JSON map (role-name →
//     %), not as DB enums; the design's "Winner / Communicator /
//     Eligible team" labels are seed data, not schema constants.
//   - `poolMode` toggles between `percentage` (poolValue is a % of
//     project revenue) and `fixed` (poolValue is a USD amount).
//   - ProjectCategory is a tree (parent → sub-categories like
//     Upwork → Johnny / Michele) with color + archive + a soft
//     pointer to its default rule.
//   - Project snapshots its commission contract by FK to a specific
//     CommissionRule version, not by duplicating JSON. Rule versions
//     are immutable (publishing a new version creates a new row), so
//     the FK is a stable historical contract.
//   - ProjectAssignment is the per-project role/percentage truth.
//     For a default-percentages project, rows are derived from the
//     rule's rolePercentages at create time. When hasOverride is on,
//     the assignment percentages diverge from the rule defaults and
//     the project records the override reason.

model ProjectCategory {
  id            String           @id @default(cuid())
  slug          String           @unique
  name          String
  description   String?
  color         String           @default("violet")
  parentId      String?
  parent        ProjectCategory? @relation("CategoryTree", fields: [parentId], references: [id])
  children      ProjectCategory[] @relation("CategoryTree")
  archived      Boolean          @default(false)
  // Soft pointer to the rule the UI should suggest by default when a
  // new project is created under this category. SetNull because rules
  // are immutable per version — when a new version supersedes the
  // pointer target, the seed/publish flow updates the pointer.
  defaultRuleId String?
  defaultRule   CommissionRule?  @relation("CategoryDefault", fields: [defaultRuleId], references: [id], onDelete: SetNull)

  projects Project[]
  rules    CommissionRule[] @relation("CategoryRules")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parentId])
  @@index([archived])
  @@index([deletedAt])
}

model Project {
  id          String @id @default(cuid())
  name        String
  clientName  String

  categoryId String
  category   ProjectCategory @relation(fields: [categoryId], references: [id])

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  // FK to the specific (immutable) rule version this project's
  // commissions are calculated against. Rule edits create a new
  // version row; this FK never silently follows.
  commissionRuleId String
  commissionRule   CommissionRule @relation(fields: [commissionRuleId], references: [id])

  // True when project assignments diverge from rule defaults.
  hasOverride    Boolean @default(false)
  overrideReason String?

  // Expected billable revenue. Drives the commission pool when the
  // rule uses poolMode='percentage'.
  revenueUsd Decimal @db.Decimal(12, 2)

  // Lifecycle. Constrained by the API layer (see projectStatusSchema)
  // to: draft | active | in_billing | on_hold | completed | cancelled | refunded.
  status String @default("draft")

  startDate              DateTime
  expectedCompletionDate DateTime?

  notes String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdById String

  assignments         ProjectAssignment[]
  commissionLineItems CommissionLineItem[]

  @@index([categoryId])
  @@index([departmentId])
  @@index([commissionRuleId])
  @@index([status])
  @@index([startDate])
  @@index([deletedAt])
}

model ProjectAssignment {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  // Role label. Convention: 'winner' | 'communicator' | 'eligible_team' but
  // not enforced by the schema — additional roles are valid as long as
  // they exist in the rule's rolePercentages map.
  roleName   String
  percentage Decimal @db.Decimal(5, 2)

  assignedAt   DateTime  @default(now())
  assignedById String
  // Soft-delete a removed assignment instead of hard-deleting so the
  // commission run for a historical month can still show "Jane was on
  // this project until April" without resurrecting the row.
  removedAt   DateTime?
  removedById String?

  @@unique([projectId, employeeId, roleName])
  @@index([projectId])
  @@index([employeeId])
  @@index([roleName])
  @@index([removedAt])
}

model CommissionRule {
  id String @id @default(cuid())

  // Identity: (department, categoryId, version). department may be
  // '*' meaning org-wide fallback. Resolution at project-create time:
  // try (project.department, categoryId), then ('*', categoryId).
  department String
  categoryId String
  category   ProjectCategory @relation("CategoryRules", fields: [categoryId], references: [id])
  version    String // semver-ish — '3.2', '3.3'. Generated by the publish flow.

  // Pool model.
  poolMode  String  // 'percentage' | 'fixed' | 'tiered'
  poolValue Decimal @db.Decimal(12, 2)

  // Revenue brackets for poolMode='tiered'. JSON array, ascending,
  // non-overlapping, exactly one open-ended (maxUsd=null) tail row:
  //   [{ minUsd, maxUsd|null, poolPct }]
  // The calc engine picks the bracket where minUsd <= revenue < maxUsd
  // and uses poolPct for the pool. Null for percentage/fixed rules.
  revenueBrackets Json?

  // Projects whose revenueUsd is below this threshold get no line
  // items in the monthly run. 0 = no threshold (the default).
  minProjectRevenueUsd Decimal @default(0) @db.Decimal(12, 2)

  // Per-person, per-project payout guardrails applied by the calc
  // engine to each line item's calculatedAmountUsd (before manual /
  // leave adjustments). null = no bound.
  //   - perPersonFloorUsd: raise an eligible (non-zero) share up to
  //     this minimum.
  //   - perPersonCapUsd: clamp a share down to this ceiling.
  // Validated cap >= floor at the API layer.
  perPersonFloorUsd Decimal? @db.Decimal(12, 2)
  perPersonCapUsd   Decimal? @db.Decimal(12, 2)

  // Roles + splits as JSON. Shape: { winner: 58, communicator: 30, eligible_team: 12 }.
  // Sum should equal 100 in any non-pending row.
  rolePercentages Json
  // Disbursement schedule placeholder — format locked in Session 2
  // (single-shot vs monthly fractions vs milestone). Stored as JSON
  // so the schema doesn't need to migrate when the format crystallises.
  disbursementSchedule Json?

  effectiveFrom DateTime
  effectiveTo   DateTime?

  // Status. Constrained by the API layer to: draft | active | pending | archived.
  // 'pending' matches PNG 11's "Awaiting decision" row — rule slot
  // exists but the numbers haven't been settled yet, so it cannot be
  // used to back a new project.
  status        String  @default("active")
  pendingReason String?

  createdAt     DateTime  @default(now())
  createdById   String
  publishedAt   DateTime?
  publishedById String?

  projects             Project[]
  defaultForCategories ProjectCategory[] @relation("CategoryDefault")

  @@unique([department, categoryId, version])
  @@index([department, categoryId])
  @@index([effectiveFrom, effectiveTo])
  @@index([status])
}

// ---------- Phase 2 Session 2: Commission Run + Line Item ----------
//
// One CommissionRun per (calendar) month per organization. State
// machine: draft → pending_approval → approved (terminal for Phase 2;
// `locked` is the Phase-7 step after payout files are generated).
// `rejected` sends the run back to draft.
//
// Line items are the unit of payment: one row per (project,
// employee, role) tuple per run, with explicit
// calculation/leave/manual columns that sum to `finalAmountUsd`.
// Adjustments + leave + carry-forward all flow through the same
// row so the audit trail and CSV export are uniform.

model CommissionRun {
  id String @id @default(cuid())

  // 'YYYY-MM' — the month the run is FOR (not when created).
  monthKey String

  // Pinned FX rate for downstream PKR conversion. Display-only in
  // Phase 2; Phase 7 reads it to mint payslips.
  fxRateUsdToPkr Decimal @db.Decimal(14, 6)

  // Status. API enforces: draft | pending_approval | approved |
  // rejected | locked. `rejected` collapses back to draft; the
  // rejectReason field is set so the next draft pass shows the
  // reviewer's note.
  status String @default("draft")

  // Lifecycle actors + timestamps. Captured per-transition so the
  // audit trail is dense even outside AuditLog.
  createdAt    DateTime  @default(now())
  createdById  String
  submittedAt  DateTime?
  submittedById String?
  approvedAt   DateTime?
  approvedById String?
  // True when the submitter and approver are the same person.
  // Captured per-row so the soft-SoD warning banner doesn't have to
  // re-derive at display time.
  approverIsSubmitter Boolean @default(false)
  rejectedAt   DateTime?
  rejectedById String?
  rejectReason String?
  lockedAt     DateTime?
  lockedById   String?

  // The typed-phrase confirmation from PNG 10 — captured for audit.
  approvalConfirmationPhrase String?

  notes String?

  lineItems CommissionLineItem[]

  @@unique([monthKey])
  @@index([status])
  @@index([monthKey])
}

model CommissionLineItem {
  id String @id @default(cuid())

  runId String
  run   CommissionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  // The project + employee + role this line is for. employeeId &
  // projectId are NOT FK-cascaded — when an employee or project is
  // soft-deleted, their historical line items must remain readable.
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id])
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  roleName   String

  // Snapshot of the assignment percentage at calc time, so future
  // edits to ProjectAssignment.percentage don't silently shift past
  // line items.
  snapshotPercentage Decimal @db.Decimal(5, 2)

  // Snapshot of base inputs at calc time. baseRevenueUsd is the
  // project's revenue field; monthFractionNumerator /
  // monthFractionDenominator encode the days-in-month overlap the
  // PNG-09 `DATE 28/28` column displays.
  baseRevenueUsd            Decimal @db.Decimal(12, 2)
  monthFractionNumerator    Int
  monthFractionDenominator  Int

  // Computed amount before adjustments.
  calculatedAmountUsd Decimal @db.Decimal(12, 2)

  // Adjustments. Each defaults to 0; HR fills them in during draft
  // review. The audit-log middleware captures every PATCH on these
  // columns.
  leaveAdjustmentUsd   Decimal @default(0) @db.Decimal(12, 2)
  manualAdjustmentUsd  Decimal @default(0) @db.Decimal(12, 2)
  manualAdjustmentNote String?

  // Held mid-run — the row's amount is moved to the next run as a
  // carry-forward line. We mark BOTH directions:
  //   - the held row in this run gets carryForwardToRunId pointing
  //     at next month's run (set when next run's draft is created)
  //   - the next month's carry-forward row gets
  //     carryForwardFromRunId pointing back here
  isHeld                Boolean @default(false)
  carryForwardToRunId   String?
  carryForwardFromRunId String?

  // Final amount = calculated + leaveAdj + manualAdj. Computed at
  // write time so the API can serve totals without re-running the
  // math.
  finalAmountUsd Decimal @db.Decimal(12, 2)

  // System-generated reversal line. Set when a project is refunded:
  // the next draft run emits a negative line clawing back commissions
  // already paid on that project. Distinguishes reversals from the
  // manually-added lines that also carry a zero month-fraction.
  isClawback Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disputes CommissionDispute[]

  @@index([runId])
  @@index([projectId])
  @@index([employeeId])
  @@index([carryForwardToRunId])
  @@index([carryForwardFromRunId])
  @@unique([runId, projectId, employeeId, roleName])
}

// ---------- Phase 2+: Commission dispute / query flow ----------
//
// An employee who can see their commission breakdown may flag a
// specific line item as "this looks wrong" and route it to HR. The
// dispute is a tracking/communication artifact — resolving it records
// a status + note only; any actual dollar fix is a separate draft
// line-item adjustment.
//
// The line-item FK is SetNull (a recalculate wipes + regenerates line
// items); the run/employee/project/role/amount are denormalised so a
// dispute stays readable even after its line item is regenerated.

model CommissionDispute {
  id String @id @default(cuid())

  // Optional link to the disputed line item. SetNull on delete so the
  // dispute survives a recalculate.
  lineItemId String?
  lineItem   CommissionLineItem? @relation(fields: [lineItemId], references: [id], onDelete: SetNull)

  // Denormalised context (snapshotted at raise time).
  runId           String
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  projectId       String?
  roleName        String?
  disputedAmountUsd Decimal? @db.Decimal(12, 2)

  // Who raised it (the employee's user id) + their message.
  raisedById String
  reason     String

  // Lifecycle: open → resolved | rejected. resolutionNote + actor
  // captured on close.
  status         String    @default("open") // open | resolved | rejected
  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([runId])
  @@index([employeeId])
  @@index([status])
  @@index([lineItemId])
}

// ---------- Audit ----------

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  module    String
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([module, createdAt])
}

// ---------- Notifications (Phase 3) ----------

/// One row per delivered notification, regardless of channel.
///
/// The `channel` column records what was attempted; the `status` column
/// tracks the in-app lifecycle (unread → read → dismissed). For email-only
/// notifications the row still lands here (with sentAt populated) so the
/// audit trail has a single source of truth — the in-app status just
/// stays `sent` rather than progressing through read/dismissed.
///
/// Polymorphic source via (sourceType, sourceId) so a notification can
/// link back to whatever triggered it (a commission run, a reminder, an
/// approval, an employee profile change).
model Notification {
  id              String  @id @default(cuid())
  recipientUserId String
  recipient       User    @relation("UserNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)
  /// Type key — registered via the NotificationTypes registry on module
  /// init. e.g. "commission.run.approved", "employee.probation.ending".
  type            String
  title           String
  body            String
  /// Optional in-app deep link. Clicking the notification navigates here
  /// and auto-marks as read.
  link            String?
  /// Arbitrary type-specific data the renderer + email template can read.
  payload         Json?
  /// `info` | `success` | `warning` | `danger`. Drives the badge tone in
  /// the bell popover and any future inbox UI.
  severity        String  @default("info")
  /// `in_app` | `email` | `both`. What was actually attempted at send
  /// time — derived from the user's NotificationPreference at send.
  channel         String  @default("in_app")
  /// `unread` | `read` | `dismissed` | `sent` (email-only flows).
  status          String  @default("unread")
  sourceType      String?
  sourceId        String?
  createdAt       DateTime  @default(now())
  readAt          DateTime?
  /// Explicit "I've handled this" marker — stronger than `read` (which
  /// auto-fires on click). Independent of dismissal.
  acknowledgedAt  DateTime?
  /// When set and in the future, the notification is hidden from the
  /// bell + unread count until this time passes, then it resurfaces.
  snoozedUntil    DateTime?
  sentAt          DateTime?
  /// Email-channel idempotency — populated when the email transport
  /// reports a provider message id (Resend) or a queued indicator (SMTP).
  emailMessageId  String?

  @@index([recipientUserId, status, createdAt])
  @@index([recipientUserId, type, createdAt])
  @@index([sourceType, sourceId])
  @@index([type, createdAt])
}

// ---------- Reminders (Phase 3) ----------

/// A reminder rule — versioned, like CommissionRule.
///
/// Two trigger flavors:
///   - `event` : when an event matching `triggerSpec.eventType` fires,
///     compute a `scheduledFor` from `triggerSpec.relativeTo` (a field
///     on the event payload) plus `triggerSpec.offset` (ISO duration,
///     e.g. `-P30D`). Insert a Reminder row.
///   - `cron`  : on each scheduler tick, run the rule's
///     `triggerSpec.query` against the source entity, fire reminders
///     for matches (e.g. "employees with probationEndDate in 30d").
///
/// `recipientResolver` is the key of a registered resolver — modules
/// declare their own and the registry maps keys to functions that
/// compute `(rule, source) → userId[]`.
///
/// Versioning: publishing a rule stamps `effectiveTo` on the previous
/// active version and creates a new row. Already-scheduled reminders
/// keep their FK to the old rule row, so policy changes never alter
/// past behavior.
model ReminderRule {
  id                String   @id @default(cuid())
  /// Stable user-friendly key — used by recipient resolvers and seeds.
  /// Unique across active versions; multiple archived versions of the
  /// same key are allowed.
  key               String
  name              String
  description       String?
  status            String   @default("draft")  // draft | active | archived
  /// Per-design (PNG 12): each rule can be scoped to a department.
  /// null = applies org-wide ("All"). Drives the Dept column + chip
  /// color in the rules library, and is read by the trigger
  /// evaluator to narrow the source-entity match set.
  departmentId      String?
  department        Department? @relation("ReminderRulesByDepartment", fields: [departmentId], references: [id])
  /// Per-design: each row has an ON/OFF toggle independent of the
  /// active/archived versioning state. A rule can be active + disabled
  /// (i.e. scheduled to evaluate but currently muted). Defaults to
  /// true so a freshly-published rule starts firing immediately.
  isEnabled         Boolean  @default(true)
  /// `event` or `cron`.
  triggerType       String
  /// JSON spec — shape depends on triggerType. See module docstring.
  triggerSpec       Json
  /// FK-like reference to NotificationType.key (no FK to keep types
  /// registry decoupled from the DB).
  notificationType  String
  /// Key of a registered RecipientResolver. LEGACY single-source field.
  /// New rules write `recipientResolvers` instead; we keep this column
  /// for back-compat reads of rules created before Phase 3.5.
  recipientResolver String
  /// New multi-source recipient list: Array<{ kind: string; config?: object }>.
  /// `kind` references a key from the resolver registry; `config` is the
  /// resolver-specific param blob (e.g. { userIds: [...] } for specific-users).
  /// Final recipient list = dedup'd union of every entry. Null = fall back to
  /// the legacy single-string column.
  recipientResolvers Json?
  version           String   @default("1.0")
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  publishedAt       DateTime?
  publishedById     String?
  createdAt         DateTime @default(now())
  createdById       String
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  reminders Reminder[]

  @@index([key, status])
  @@index([status, triggerType])
  @@index([notificationType])
}

/// A scheduled reminder instance — one row per (rule × target × scheduledFor).
///
/// Inserted by the trigger evaluator (event-based) or the cron tick
/// (time-based). Fired by the scheduler loop when `scheduledFor` is
/// in the past; transition to `fired` writes the FK to the resulting
/// Notification row.
model Reminder {
  id              String   @id @default(cuid())
  ruleId          String
  rule            ReminderRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  recipientUserId String
  /// Polymorphic source — the entity the reminder is about.
  sourceType      String?
  sourceId        String?
  /// Local-time-anchored fire-at. Stored UTC; the evaluator converts
  /// before scheduling so "9 AM Asia/Karachi" lands at the right epoch.
  scheduledFor    DateTime
  status          String   @default("scheduled")  // scheduled | fired | cancelled | failed
  /// Optional context the notification renderer can read.
  payload         Json?
  firedAt         DateTime?
  notificationId  String?
  cancelledAt     DateTime?
  cancelReason    String?
  /// Delivery retry bookkeeping. Each failed send increments
  /// `attempts` and pushes `scheduledFor` out by a backoff step; once
  /// `attempts` hits the cap the row moves to `status='failed'`
  /// (dead-letter) instead of looping forever. `lastError` keeps the
  /// most recent failure message for the ops view.
  attempts        Int      @default(0)
  lastError       String?
  lastAttemptAt   DateTime?
  createdAt       DateTime @default(now())
  /// Idempotency key. Computed at schedule time as
  ///   `${ruleId}|${recipientUserId}|${sourceType ?? '_'}|${sourceId ?? '_'}|${scheduledFor.toISOString().slice(0,13)}`
  /// — hour-bucketed so retried event fires + repeated cron ticks
  /// within the same hour can't create duplicate scheduled rows.
  /// `createMany({ skipDuplicates: true })` no-ops on duplicates.
  dedupeKey       String?  @unique

  @@index([status, scheduledFor])
  @@index([ruleId, status])
  @@index([recipientUserId, status])
  @@index([sourceType, sourceId])
}

/// Per-user, per-type, per-channel toggle.
///
/// Absence implies the type's registered default (in-app on, email on for
/// `severity >= warning`). A row exists only when the user has explicitly
/// overridden a default — keeps the table small and lookups cheap.
/// User-defined notification types. Modules ship a static set via
/// the NotificationTypesRegistry; this table lets HR admins add new
/// ones at runtime without a deploy. On boot + on each mutation, the
/// registry hydrates active rows into the same in-memory map as the
/// static types — at send time, the runtime treats them identically.
model CustomNotificationType {
  id            String   @id @default(cuid())
  /// Stable identifier. Convention: prefix with `custom.` so they're
  /// visually distinct from module-shipped types in the picker.
  key           String   @unique
  name          String
  description   String?
  /// info | success | warning | danger — must match the Severity union.
  severity      String   @default("info")
  /// Channels enabled by default — overridden per user via prefs.
  channels      String[] @default(["in_app"])
  titleTemplate String
  bodyTemplate  String
  linkTemplate  String?
  isActive      Boolean  @default(true)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Notification type key.
  type      String
  /// `in_app` | `email` | `push` | `slack`. push + slack are accepted
  /// here so future channels don't need a migration; they're not honored
  /// by any sender in Phase 3.
  channel   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type, channel])
  @@index([userId])
}

// ---------- Approvals (Phase 3) ----------

/// Generic approval record. One row per (sourceType, sourceId) under
/// active review, regardless of the underlying module.
///
/// Modules register an ApprovalType (in the in-memory registry — see
/// approval-type.registry.ts) that declares:
///   - decisionPolicy (single / multi / threshold)
///   - requiredPermission (who can act on this kind)
///   - softSoD (whether the submitter may also approve)
///   - sourceResolver (load the source for display)
///   - confirmationPhraseFor (the PNG-10-style typed phrase if any)
///   - onApproved / onRejected / onCancelled side effects
///
/// `requiredPermission` is denormalised onto the row so the inbox can
/// filter purely on the DB without the registry having to be queried —
/// the cluster of (type, status, requiredPermission) is the inbox's
/// hot index.
model Approval {
  id                 String   @id @default(cuid())
  type               String
  sourceType         String
  sourceId           String
  status             String   @default("pending")  // pending | approved | rejected | cancelled
  submittedById      String
  submittedBy        User     @relation("ApprovalSubmitter", fields: [submittedById], references: [id])
  submittedAt        DateTime @default(now())
  requiredPermission String
  decisionPolicy     String   @default("single")  // single | multi | threshold
  thresholdCount     Int?
  /// Snapshot of the approver chain at submit time (immutable for the
  /// life of this approval). JSON array of { requiredPermission, label }.
  /// null / single-element = single-stage (legacy behaviour). The
  /// denormalised `requiredPermission` above always points at the
  /// stage currently awaiting a decision.
  stages             Json?
  /// Index of the stage awaiting a decision. Advances on each approve;
  /// when it passes the last stage the approval resolves to 'approved'.
  currentStage       Int      @default(0)
  /// Display metadata captured at submit time — frees the inbox row
  /// from a per-render lookup against the source entity. The frontend
  /// reads { title, sub, meta, requesterName, requesterRole,
  /// requesterHue, severity, … } off this blob.
  metadata           Json?
  resolvedAt         DateTime?
  resolvedById       String?
  resolveReason      String?

  decisions ApprovalDecision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status, submittedAt])
  @@index([status, submittedAt])
  @@index([sourceType, sourceId, status])
  @@index([submittedById])
}

/// One row per individual approver action. For `single`-policy
/// approvals there's at most one row; multi/threshold accumulate
/// multiple. `confirmationData` is type-specific JSON the registered
/// validator interprets (typed phrase, free-form notes, etc.).
model ApprovalDecision {
  id               String   @id @default(cuid())
  approvalId       String
  approval         Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  decidedById      String
  decidedBy        User     @relation(fields: [decidedById], references: [id])
  decision         String   // approve | reject
  /// Which stage (index into Approval.stages) this decision resolved.
  /// null for legacy single-stage rows.
  stageIndex       Int?
  confirmationData Json?
  decidedAt        DateTime @default(now())

  @@index([approvalId, decidedAt])
  @@index([decidedById])
}
