# =============================================================================
# Futurenostics HRMS — environment template.
# Copy to `.env` and fill in real secrets:  cp .env.example .env
# `.env` is the SINGLE source of truth for BOTH native dev and Docker; it is
# gitignored. Every variable is validated against the zod schema at apps/api
# startup (apps/api/src/config/env.schema.ts).
#
# Values assume the NATIVE case (apps on your host → localhost:<published port>).
# Docker overrides only the connection hosts in docker-compose.yml.
# =============================================================================

# ---------- Host ports (your machine) ----------
# Remapped off the defaults (5432/6379/9000) to avoid clashes with other local
# projects. Keep DATABASE_URL / REDIS_URL / S3_ENDPOINT in sync if you change them.
WEB_HOST_PORT=3000
API_HOST_PORT=4000
STUDIO_HOST_PORT=5555
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6380
MINIO_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

# ---------- Database ----------
DATABASE_URL=postgresql://hrms:hrms_dev_password@localhost:5434/hrms_dev
POSTGRES_USER=hrms
POSTGRES_PASSWORD=hrms_dev_password
POSTGRES_DB=hrms_dev

# ---------- Redis (cache + BullMQ queues) ----------
REDIS_URL=redis://localhost:6380

# ---------- JWT ----------
# Generate strong secrets with:  openssl rand -base64 64 | tr -d '\n'
JWT_ACCESS_SECRET=replace-me-with-a-strong-secret
JWT_REFRESH_SECRET=replace-me-with-a-different-strong-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---------- Object storage (S3-compatible / MinIO) ----------
# S3_ACCESS_KEY / S3_SECRET_KEY double as the MinIO root credentials in Docker.
S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_dev_password
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
DOCUMENTS_BUCKET=fn-hrms-documents
TEMPLATES_BUCKET=fn-hrms-template-assets

# ---------- Email ----------
# Provider: 'mailpit' (dev), 'smtp' (generic), or 'resend' (prod).
EMAIL_PROVIDER=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Futurenostics HRMS <no-reply@futurenostics.local>"
RESEND_API_KEY=

# ---------- App URLs ----------
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Browser-side variable; baked into the Next.js bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------- Runtime ----------
NODE_ENV=development
LOG_LEVEL=debug
PORT=4000

# ---------- Seed data (used by `pnpm db:seed`) ----------
SEED_ADMIN_EMAIL=admin@futurenostics.local
SEED_ADMIN_PASSWORD=ChangeMe!Now123

# ---------- Timezone (display + scheduling) ----------
TZ=Asia/Karachi

# ---------- Docker-only toggle ----------
# Skip the idempotent seed on api container start with RUN_SEED=false.
RUN_SEED=true
