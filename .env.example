# =============================================================================
# Futurenostics HRMS — environment variables
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# Every variable here is validated against the zod schema at apps/api startup.
# =============================================================================

# ---------- Database ----------
DATABASE_URL=postgresql://hrms:hrms_dev_password@localhost:5432/hrms_dev

# ---------- Redis (cache + BullMQ queues) ----------
REDIS_URL=redis://localhost:6379

# ---------- JWT ----------
# Generate strong secrets with:
#   openssl rand -base64 64 | tr -d '\n'
JWT_ACCESS_SECRET=replace-me-with-a-strong-secret
JWT_REFRESH_SECRET=replace-me-with-a-different-strong-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---------- Object storage (S3-compatible) ----------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_dev_password
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
DOCUMENTS_BUCKET=fn-hrms-documents
TEMPLATES_BUCKET=fn-hrms-template-assets

# ---------- Email ----------
# Provider: 'mailpit' (dev), 'smtp' (generic), or 'resend' (prod).
EMAIL_PROVIDER=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Futurenostics HRMS <no-reply@futurenostics.local>"
RESEND_API_KEY=

# ---------- App URLs ----------
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---------- Runtime ----------
NODE_ENV=development
LOG_LEVEL=debug
PORT=4000

# ---------- Seed data (used by `pnpm db:seed`) ----------
SEED_ADMIN_EMAIL=admin@futurenostics.local
SEED_ADMIN_PASSWORD=ChangeMe!Now123

# ---------- Timezone (display + scheduling) ----------
TZ=Asia/Karachi
